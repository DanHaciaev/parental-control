rules_version = '2';

// This is effectively the entire backend (no Cloud Functions on the free Spark plan),
// so every family's data isolation depends entirely on these rules being correct.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParent(familyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/families/$(familyId)).data.parentUid == request.auth.uid;
    }

    function isChild(familyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/families/$(familyId)).data.childUid == request.auth.uid;
    }

    function isDevice(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/devices/$(request.auth.uid));
    }

    function isFamilyMember(familyId) {
      return isParent(familyId) || isChild(familyId) || isDevice(familyId);
    }

    match /families/{familyId} {
      allow read: if isSignedIn() &&
        (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.parentUid == request.auth.uid &&
        (!('childUid' in request.resource.data) || request.resource.data.childUid == null);
      allow update: if isParent(familyId) ||
        (isChild(familyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingCommand'])) ||
        (isSignedIn() && resource.data.childUid == null &&
          request.resource.data.childUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childUid']));
      allow delete: if false;

      match /rules/{packageName} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if isParent(familyId) &&
          request.resource.data.mode in ['BLOCKED', 'TIME_LIMIT'] &&
          (request.resource.data.dailyLimitMinutes == null || request.resource.data.dailyLimitMinutes is int);
        allow delete: if isParent(familyId);
      }

      match /usageDaily/{entryId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isChild(familyId);
      }

      match /usageHourly/{entryId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isChild(familyId);
      }

      match /deviceStatus/{docId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isChild(familyId);
      }

      match /location/{docId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isChild(familyId);
      }

      match /geofences/{zoneId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }

      match /schedules/{scheduleId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }

      match /history/{entryId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isChild(familyId);
      }

      match /installedApps/{packageName} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if isChild(familyId);
        allow update: if isParent(familyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus']);
      }

      match /events/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId);
        allow update: if isParent(familyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }

      match /requests/{requestId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isChild(familyId);
        allow update: if isParent(familyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedMinutes']);
        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isParent(familyId) &&
          request.resource.data.rewardMinutes is int && request.resource.data.rewardMinutes > 0;
        allow update: if isParent(familyId) ||
          (isChild(familyId) && resource.data.status == 'OPEN' &&
            request.resource.data.status == 'DONE_BY_CHILD' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']));
        allow delete: if isParent(familyId);
      }

      match /assignedSkills/{skillId} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if isParent(familyId);
        allow delete: if isParent(familyId);
      }

      match /skillProgress/{entryId} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if isChild(familyId) &&
          request.resource.data.approved == false &&
          (resource == null || resource.data.approved == false);
        allow update: if isParent(familyId);
        allow delete: if false;
      }

      match /listenSession/current {
        allow read: if isFamilyMember(familyId);

        // Разрешаем родителю создавать сессию сразу со статусом 'ACTIVE' или 'PENDING_CONSENT'
        allow create: if isParent(familyId) && 
          request.resource.data.status in ['ACTIVE', 'PENDING_CONSENT'];

        // Обновление состояния сессий
        allow update: if
          // Родитель может завершить активную сессию или повторно запросить подключение
          (isParent(familyId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt']) &&
            request.resource.data.status == 'ENDED') ||
          (isParent(familyId) && resource.data.status in ['ENDED', 'DECLINED'] &&
            request.resource.data.status in ['ACTIVE', 'PENDING_CONSENT']) ||
          
          // Ребёнок передаёт answerSdp или завершает поток без привязки к PENDING_CONSENT
          (isChild(familyId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answerSdp', 'respondedAt', 'endedAt']) &&
            request.resource.data.status in ['ACTIVE', 'DECLINED', 'ENDED']);

        allow delete: if false;

        match /callerCandidates/{candidateId} {
          allow read: if isFamilyMember(familyId);
          allow create: if isParent(familyId);
          allow update, delete: if false;
        }

        match /calleeCandidates/{candidateId} {
          allow read: if isFamilyMember(familyId);
          allow create: if isChild(familyId);
          allow update, delete: if false;
        }
      }

      match /devices/{deviceId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isSignedIn() && request.auth.uid == deviceId;
        allow update: if
          (isParent(familyId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['label', 'dailyLimitMinutes', 'pendingCommand'])) ||
          (isSignedIn() && request.auth.uid == deviceId &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['todayDateKey', 'todayMinutesUsed', 'lastSeenAt', 'pendingCommand']));
        allow delete: if isParent(familyId);
      }
    }

    match /pairingCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isParent(request.resource.data.familyId) &&
        request.resource.data.used == false;
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']) &&
        resource.data.used == false;
      allow delete: if false;
    }
  }
}